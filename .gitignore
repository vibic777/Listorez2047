# Listorez2047 — ignore build junk, secrets, and user documents dropped into the repo.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtualenv (keep local; do not commit)
.venv/
venv/
env/

# PyInstaller generated spec (scripts/build_*. write it)
*.spec

# Built Windows binaries belong in GitHub Releases, not in git
*.exe

# IDE
.idea/
.vscode/
*.swp
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

# App logs created while developing (including Listorez2047.log)
*.log
logs/

# OCR / model download cache if any
.rapidocr_cache/
.cache/
.huggingface/
/assets/models/*.onnx

# Local app settings if copied into the repo (real config lives in AppData\Listorez2047)
/config.json
.env
.env.*
.secrets/
secrets/
secrets.*
.aws/
.ssh/
.azure/
.kube/
.docker/
.terraform/
.npmrc
.pypirc
.netrc
*.tfstate
*.tfstate.*
credentials.json
credentials.*.json
*_credentials.json
*_secret*
*_token*

# Private keys, signing certificates, and local credential stores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa
id_ed25519

# User documents accidentally dropped into the project
*.pdf
*.pdfocr.json

# Temp leftovers
tmp/
*.tmp
*.bak
*.orig
pytest-cache-files-*/
# Local secrets, signing material, and private runtime data
.env
.env.*
!.env.example
!.env.*.example
!.env.template
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
keystore.properties
signing.properties
local.properties
credentials/
secrets/
*credentials*.json
*secret*.json
*.sqlite*
*.db
*.db-*
*.session
*.session-journal
.vscode/
.idea/workspace.xml
.idea/tasks.xml
